{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~/.ssh/**)"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "dark",
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "3600000"
  }
}
